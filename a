#!/usr/bin/env bash
USER_PWD="$PWD"
cd "$(dirname $0)"

VERBOSE=0

# --- Parse flags ---
ARGS=()
for arg in "$@"; do
    case "$arg" in
        -v|--verbose) VERBOSE=1 ;;
        -h|--help)
            echo "Usage: pls [OPTIONS] <command description>"
            echo ""
            echo "Translates natural language into shell commands using AI."
            echo ""
            echo "Options:"
            echo "  -v, --verbose   Show API requests and raw responses"
            echo "  -h, --help      Show this help message"
            echo ""
            echo "Examples:"
            echo "  pls list my files"
            echo "  please how big are my files"
            echo "  pls show my current git branch"
            echo "  pls -v find all python files"
            exit 0
            ;;
        *) ARGS+=("$arg") ;;
    esac
done

QUERY="${ARGS[*]}"

if [ -z "$QUERY" ]; then
    echo "Usage: pls [OPTIONS] <command description>"
    echo "Try 'pls --help' for more information."
    exit 0
fi

# --- Weaviate cache lookup ---
CACHED_COMMAND=""
if command -v curl >/dev/null 2>&1; then
    ./scripts/weaviate.sh init 2>/dev/null
    CACHED_COMMAND=$(./scripts/weaviate.sh search "$QUERY" 2>/dev/null)
fi

if [ -n "$CACHED_COMMAND" ]; then
    COMMAND="$CACHED_COMMAND"
    echo -e "\033[32m> $COMMAND (cached)\033[0m"
else
    # Get command from AI provider (stdout = command, stderr = verbose/debug)
    VERBOSE_FLAG=""
    [ "$VERBOSE" -eq 1 ] && VERBOSE_FLAG="-v"
    COMMAND=$(./scripts/chat.sh "" "$QUERY" "$USER_PWD" $VERBOSE_FLAG)
    echo -e "\033[36m> $COMMAND\033[0m"

    # Store in Weaviate for future use (if available, fully detached)
    if command -v curl >/dev/null 2>&1; then
        ./scripts/weaviate.sh store "$QUERY" "$COMMAND" </dev/null >/dev/null 2>&1 &
    fi
fi

# Check for dangerous commands
if [[ "$COMMAND" =~ ^(rm|sudo|dd|mkfs|fdisk|format|del|deltree|shutdown|reboot|halt|init|kill|killall|pkill|chmod.*777|chown.*root) ]]; then
    echo -e "\033[31mWarning: Potentially dangerous command detected!\033[0m"
    read -p "Are you sure you want to execute this? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Command cancelled."
        exit 0
    fi
fi

cd "$USER_PWD"
eval "$COMMAND"
